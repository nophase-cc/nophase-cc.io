#!/usr/bin/env bash
# Build the home page feed locally (writes tmp/feed.json). See _data/feeds.yml.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -x "$HOME/.rubies/ruby-3.1.3/bin/ruby" ]]; then
  RUBY_BIN="$HOME/.rubies/ruby-3.1.3/bin/ruby"
else
  RUBY_BIN="ruby"
fi

"$RUBY_BIN" scripts/fetch-feeds.rb "$@"
