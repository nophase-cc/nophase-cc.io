#!/usr/bin/env bash
set -euo pipefail

if [[ -x "$HOME/.rubies/ruby-3.1.3/bin/bundle" ]]; then
  BUNDLE_BIN="$HOME/.rubies/ruby-3.1.3/bin/bundle"
else
  BUNDLE_BIN="bundle"
fi

export BUNDLE_PATH="vendor/bundle"
export BUNDLE_APP_CONFIG=".bundle"

"$BUNDLE_BIN" install

if [[ -x "/usr/local/opt/node@20/bin/node" && -f "/usr/local/opt/node@20/lib/node_modules/npm/bin/npm-cli.js" ]]; then
  NODE_BIN="/usr/local/opt/node@20/bin/node"
  NPM_CLI="/usr/local/opt/node@20/lib/node_modules/npm/bin/npm-cli.js"
  NPM_CMD=("$NODE_BIN" "$NPM_CLI")
elif [[ -x "/opt/homebrew/opt/node@20/bin/node" && -f "/opt/homebrew/opt/node@20/lib/node_modules/npm/bin/npm-cli.js" ]]; then
  NODE_BIN="/opt/homebrew/opt/node@20/bin/node"
  NPM_CLI="/opt/homebrew/opt/node@20/lib/node_modules/npm/bin/npm-cli.js"
  NPM_CMD=("$NODE_BIN" "$NPM_CLI")
elif command -v npm >/dev/null 2>&1; then
  NPM_CMD=("npm")
else
  echo "npm not found. Install Node.js/npm to build Chirpy JS/CSS assets."
  exit 1
fi

"${NPM_CMD[@]}" install
"${NPM_CMD[@]}" run build
